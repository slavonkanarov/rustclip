import { Button } from "std-widgets.slint";
import { ClipRow, ShortcutRow, TemplateRow } from "models.slint";
import { HistoryView } from "history.slint";
import { TemplatesView, TemplateEditor } from "templates.slint";
import { SettingsView } from "settings.slint";
export { PreviewWindow } from "preview.slint";
export { TrayIcon } from "tray.slint";

export component MainWindow inherits Window {
    title: root.settings-open ? "rustclip — Settings" : "rustclip";
    preferred-width: 940px;
    preferred-height: 680px;
    min-width: 760px;
    min-height: 560px;
    background: #171a21;
    in-out property <[ClipRow]> clips;
    in-out property <[ShortcutRow]> shortcuts;
    in-out property <[TemplateRow]> template-rows;
    in-out property <int> page: 0;
    in-out property <bool> settings-open: false;
    in-out property <bool> template-editor-open: false;
    in-out property <int> selected-shortcut: 0;
    in-out property <string> search-text;
    in-out property <string> status-text: "Ready";
    in-out property <bool> has-selection: false;
    in-out property <string> quick-hint;
    in-out property <int> selected-index: -1;
    in-out property <bool> saving: false;
    in-out property <int> template-kind: 0;
    in-out property <string> template-name;
    in-out property <string> template-content;
    in-out property <string> template-search;
    in-out property <int> settings-section: 0;
    in-out property <bool> start-hidden: true;
    in-out property <bool> start-with-windows: false;
    in-out property <bool> paste-enabled: true;
    in-out property <bool> restore-clipboard: false;
    in-out property <string> paste-delay-text: "150";
    in-out property <string> history-limit-text: "64";

    callback refresh-preview();
    callback open-history();
    callback open-templates();
    callback open-settings();
    callback cancel-settings();
    callback select-clip(int);
    callback activate-clip(int);
    callback copy-selected();
    callback paste-selected();
    callback delete-selected();
    callback navigate-clip(int);
    callback clear-history();
    callback search-changed();
    callback toggle-modifier(int, int, bool);
    callback capture-key(int);
    callback clear-shortcut(int);
    callback save-settings();
    callback reset-settings();
    callback exit-app();
    callback select-template(int);
    callback toggle-template-group(int);
    callback new-template-group();
    callback new-template();
    callback save-template();
    callback delete-template();
    callback copy-template();
    callback paste-template();
    callback cancel-template-edit();
    callback template-search-changed();
    callback handle-key(string, bool, bool, bool, bool) -> bool;
    public function focus-search() { history.focus-search(); }


    forward-focus: keys;
    keys := FocusScope {
        capture-key-pressed(event) => {
            if root.handle-key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta) { accept } else { reject }
        }
        VerticalLayout {
            padding: 16px; spacing: 12px;
            HorizontalLayout {
                height: 40px; spacing: 8px;
                Text { text: "rustclip"; color: #f4edff; font-size: 22px; font-weight: 700; vertical-alignment: center; min-width: 112px; }
                Button { text: "History"; primary: !root.settings-open && root.page == 0; enabled: !root.saving; clicked => { root.open-history(); } }
                Button { text: "Templates"; primary: !root.settings-open && root.page == 1; enabled: !root.saving; clicked => { root.open-templates(); } }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Settings"; primary: root.settings-open; min-width: 112px; enabled: !root.saving; clicked => { root.open-settings(); } }
            }
            Rectangle { height: 1px; background: #383d49; }
            content := Rectangle {
                vertical-stretch: 1;
                history := HistoryView {
                    visible: !root.settings-open && root.page == 0;
                    clips: root.clips; has-selection: root.has-selection;
                    paste-enabled: root.paste-enabled; selected-index: root.selected-index;
                    query <=> root.search-text; quick-hint: root.quick-hint;
                    search-changed => { root.search-changed(); }
                    select(index) => { root.select-clip(index); }
                    activate(index) => { root.activate-clip(index); }
                    copy => { root.copy-selected(); }
                    paste => { root.paste-selected(); }
                    delete => { root.delete-selected(); }
                }
                if !root.settings-open && root.page == 1: TemplatesView {
                    rows: root.template-rows; kind: root.template-kind; paste-enabled: root.paste-enabled;
                    query <=> root.template-search;
                    search-changed => { root.template-search-changed(); }
                    select(index) => { root.select-template(index); }
                    toggle-group(index) => { root.toggle-template-group(index); }
                    new-group => { root.new-template-group(); }
                    new-template => { root.new-template(); }
                    edit => { root.template-editor-open = true; }
                    delete => { root.delete-template(); }
                    copy => { root.copy-template(); }
                    paste => { root.paste-template(); }
                }
                if root.settings-open: SettingsView {
                    section <=> root.settings-section; shortcuts: root.shortcuts;
                    selected-shortcut <=> root.selected-shortcut; saving: root.saving;
                    start-hidden <=> root.start-hidden; start-with-windows <=> root.start-with-windows;
                    paste-enabled <=> root.paste-enabled; restore-clipboard <=> root.restore-clipboard;
                    paste-delay-text <=> root.paste-delay-text; history-limit-text <=> root.history-limit-text;
                    toggle-modifier(index, flag, value) => { root.toggle-modifier(index, flag, value); }
                    capture-key(index) => { root.capture-key(index); }
                    clear-shortcut(index) => { root.clear-shortcut(index); }
                    save => { root.save-settings(); }
                    cancel => { root.cancel-settings(); }
                    reset => { root.reset-settings(); }
                    clear-history => { root.clear-history(); }
                }
            }
            Text { height: 22px; text: root.status-text; color: #b8bdca; font-size: 12px; overflow: elide; vertical-alignment: center; }
        }
        if root.template-editor-open: Rectangle {
            background: #090b10d0;
            TouchArea {}
            TemplateEditor {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                width: min(620px, parent.width - 40px); height: min(480px, parent.height - 40px);
                kind: root.template-kind; name <=> root.template-name; content <=> root.template-content;
                save => { root.save-template(); }
                copy => { root.copy-template(); }
                cancel => { root.cancel-template-edit(); }
            }
        }
    }
}
